{
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "arrowParens": "always",
    "printWidth": 90,
    "singleAttributePerLine": true,
    "overrides": [
        {
            "files": ["*.json", "*.scss", "*.yml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
